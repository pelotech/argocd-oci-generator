FROM golang:1.26-alpine@sha256:87c65a688975c0b1d4585d204874c45ca78354670e3a5f11368c5a492303d696 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /generator ./cmd/argocd-oci-generator

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
LABEL org.opencontainers.image.source="https://github.com/pelotech/argocd-oci-generator" \
      org.opencontainers.image.description="Argo CD ApplicationSet plugin generator over OCI artifacts"
COPY --from=build /generator /generator
EXPOSE 8080
ENTRYPOINT ["/generator"]
